{
  "name": "@unitedlinkgroup/database",
  "version": "0.0.0",
  "private": true,
  "main": "./prisma/client/index.js",
  "types": "./prisma/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./prisma/client/index.d.ts",
      "import": "./prisma/client/index.js",
      "require": "./prisma/client/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate",
    "generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:deploy": "prisma db push --skip-generate",
    "migrate:deploy": "node prisma/prepare-postgres.js && prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "migrate:sqlite-to-postgres": "node prisma/migrate-sqlite-to-postgres.js",
    "migrate:dev": "node prisma/prepare-postgres.js && prisma migrate dev --schema prisma/postgres/schema.prisma",
    "migrate:copy-sqlite": "node prisma/copy-sqlite-to-postgres.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0"
  },
  "devDependencies": {
    "prisma": "^5.10.0"
  }
}
