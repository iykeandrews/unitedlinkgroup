{
  "cli": {
    "version": ">= 18.6.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.unitedlinkgroup.com/api"
      }
    },
    "download": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6811577530",
        "ascApiKeyPath": "ios/certs/AuthKey_27ULRV4RHT.p8",
        "ascApiKeyIssuerId": "2d798f46-5fbc-4410-81ac-4188406fc5f7",
        "ascApiKeyId": "27ULRV4RHT"
      }
    }
  }
}
