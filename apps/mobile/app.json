{
  "expo": {
    "name": "United Link Group",
    "slug": "unitedlinkgroup",
    "version": "1.0.1",
    "icon": "./assets/logo.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unitedlinkgroup.mobile",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "United Link Group uses your location while you are clocked in to verify arrival at your assigned work site and to confirm you remain within its approved work-site radius."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.unitedlinkgroup.mobile"
    },
    "web": {
      "favicon": ""
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to securely unlock your United Link account."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "81101569-3cf8-4082-ba62-e32a105b53a3"
      }
    },
    "owner": "iykeandrews"
  }
}
